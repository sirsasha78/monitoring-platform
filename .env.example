APP_NAME=example_name
APP_ENV=dev
DEBUG=true
LOG_LEVEL=DEBUG

POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_DB=monitoring
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RABBITMQ_USER=app
RABBITMQ_PASSWORD=secret
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

SCHEDULER_BATCH_SIZE=100
SCHEDULER_SLEEP_SECONDS=5
SCHEDULER_LOCK_TTL=60

INCIDENT_MIN_DURATION_SECONDS=300

OUTBOX_PUBLISHER_BATCH_SIZE=100
OUTBOX_PUBLISHER_SLEEP_SECONDS=5
OUTBOX_PUBLISHER_LOCK_TTL=60

RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

NOTIFICATION_QUEUE=notifications